  LocationTr: "Nehir ge\xE7i\u015Fi."
  TipRu: "\u0410\u0432\u0438\u0430\u0443\u0434\u0430\u0440 \u0434\u043B\u044F \u0431\u043E\u043B\u044C\u0448\u0438\u0445
