  TitleRu: "\u0417\u0430\u0449\u0438\u0442\u0430 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B"
  TitleEn: Ferry protection
  TitleTr: "Ge\xE7i\u015Fin korunmas\u0131"
  ContextRu: "\u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430 \u0437\u0430\u0447\u0438\u0449\u0435\u043D\u0430,
