  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Turkey
    Text: "Her birimin g\xF6rsel olarak g\xF6sterilen bir sald\u0131r\u0131 yar\u0131\xE7ap\u0131
      vard\u0131r. Ayr\u0131ca ek silahlar da olabilir"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0423 \u043A\u0430\u0436\u0434\u043E\u0439 \u0431\u043E\u0435\u0432\u043E\u0439
      \u0435\u0434\u0438\u043D\u0438\u0446\u044B \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E
      \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0434\u0438\u0443\u0441
      \u0430\u0442\u0430\u043A\u0438. \u0422\u0430\u043A \u0436\u0435 \u043C\u043E\u0433\u0443\u0442
