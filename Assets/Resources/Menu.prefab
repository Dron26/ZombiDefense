--- !u!114 &6347103687144363834
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5740320471982389115}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Turkey
    Text: "\"Grenadier, g\xFC\xE7l\xFC bir av t\xFCfe\u011Fiyle donanm\u0131\u015F,
      inat\xE7\u0131 bir sava\u015F\xE7\u0131d\u0131r. Onun hassas ve y\u0131k\u0131c\u0131
      \xE7ekimleri, zombilerin \xF6zg\xFCrl\xFC\u011Fe giden yolunu engelleyerek
      ate\u015Fli bir duvar yarat\u0131yor.\""
    Object: {fileID: 0}
  - Language: Russian
    Text: "\"\u0413\u0440\u0435\u043D\u0430\u0434\u0435\u0440 \u2013 \u043D\u0435\u0443\u043A\u0440\u043E\u0442\u0438\u043C\u044B\u0439
      \u0431\u043E\u0435\u0446, \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0439
      \u043C\u043E\u0449\u043D\u044B\u043C \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u043E\u043C.
      \u0415\u0433\u043E \u0442\u043E\u0447\u043D\u044B\u0435 \u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u0441\u043E\u0437\u0434\u0430\u044E\u0442
      \u043E\u0433\u043D\u0435\u043D\u043D\u0443\u044E \u0441\u0442\u0435\u043D\u0443,
      \u043F\u0440\u0435\u0433\u0440\u0430\u0436\u0434\u0430\u044F \u043F\u0443\u0442\u044C
      \u0437\u043E\u043C\u0431\u0438 \u043A \u0441\u0432\u043E\u0431\u043E\u0434\u0435.\""
    Object: {fileID: 0}
  - Language: English
    Text: '"The Grenadier is an indomitable fighter armed with a powerful shotgun.
      His accurate and destructive shots create a wall of fire, blocking the path
      of zombies to freedom."'
    Object: {fileID: 0}
