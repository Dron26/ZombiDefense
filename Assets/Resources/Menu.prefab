  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Turkey
    Text: "Ekibiniz haz\u0131r oldu\u011Funda operasyona ba\u015Flayabilirsiniz.
      Operasyon sonunda bir rapor verilecektir."
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E \u043A\u0430\u043A
      \u0442\u0432\u043E\u0439 \u043E\u0442\u0440\u044F\u0434 \u0431\u0443\u0434\u0435\u0442
      \u0433\u043E\u0442\u043E\u0432 \u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u0447\u0430\u0442\u044C
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044E.\u041F\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044E
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0438 \u0431\u0443\u0434\u0435\u0442
      \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D \u043E\u0442\u0447\u0435\u0442"
    Object: {fileID: 0}
  - Language: English
    Text: Once your squad is ready, you can start the operation. A report will be
      provided at the end of the operation.
    Object: {fileID: 0}
