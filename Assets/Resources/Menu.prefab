--- !u!114 &5498050656928756401
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4648392614294978753}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Russian
    Text: "\u0415\u0441\u043B\u0438 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0441\u0440\u0430\u0436\u0435\u043D\u0438\u044F
      \u043A\u0442\u043E \u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F,  \u0442\u043E
      \u043F\u0440\u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u0438 \u0430\u043F\u0442\u0435\u0447\u043A\u0438
      \u043C\u043E\u0436\u043D\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435"
    Object: {fileID: 0}
  - Language: English
    Text: If someone is injured during a battle, you can restore health if you have
      a first aid kit available
    Object: {fileID: 0}
  - Language: Turkey
    Text: "Sava\u015F s\u0131ras\u0131nda biri yaralan\u0131rsa, ilk yard\u0131m
      \xE7antan\u0131z varsa sa\u011Fl\u0131\u011F\u0131n\u0131 geri kazanabilirsiniz"
    Object: {fileID: 0}
