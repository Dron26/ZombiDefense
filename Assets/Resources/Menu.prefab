--- !u!114 &9078847350440733809
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1982522621457625676}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Turkey
    Text: "\"Zanaat\u0131n\u0131n ustas\u0131 olan keskin ni\u015Fanc\u0131, i\u015Fini
      kusursuz bir \u015Fekilde yap\u0131yor, \xF6l\xFCmc\xFCl at\u0131\u015Flar
      yap\u0131yor ve uzun mesafelerden kurtulanlara g\xFCvenlik sa\u011Fl\u0131yor.\""
    Object: {fileID: 0}
  - Language: Russian
    Text: "\"\u041C\u0430\u0441\u0442\u0435\u0440 \u0441\u0432\u043E\u0435\u0433\u043E
      \u0440\u0435\u043C\u0435\u0441\u043B\u0430, \u0441\u043D\u0430\u0439\u043F\u0435\u0440
      \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442
      \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443, \u043D\u0430\u043D\u043E\u0441\u044F
      \u0441\u043C\u0435\u0440\u0442\u043E\u043D\u043E\u0441\u043D\u044B\u0435 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B
      \u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u043C \u0441 \u0434\u0430\u043B\u044C\u043D\u0438\u0445
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0439.\""
    Object: {fileID: 0}
  - Language: English
    Text: '"A master of his craft, the sniper does his job flawlessly, delivering
      deadly shots and ensuring the safety of survivors from long distances."'
    Object: {fileID: 0}
