--- !u!114 &4542108417532029415
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1425141710155857442}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Turkey
    Text: "Men\xFCye \xE7\u0131kmak istedi\u011Finize emin misiniz?\n\n Lokasyonda
      kaydedilen t\xFCm ilerlemeler kaybolacak."
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B \u0447\u0442\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u044B\u0439\u0442\u0438 \u0432 
      \u043C\u0435\u043D\u044E?\n\n \u0412\u0435\u0441\u044C \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441
      \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u044B\u0439 \u043D\u0430
      \u043B\u043E\u043A\u0430\u0446\u0438\u0438 \u0431\u0443\u0434\u0435\u0442 \u0443\u0442\u0435\u0440\u044F\u043D."
    Object: {fileID: 0}
  - Language: English
    Text: "Are you sure you want to go to the menu?\n\n All progress made on the
      location will be lost."
    Object: {fileID: 0}
