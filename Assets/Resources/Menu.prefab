--- !u!114 &7352583489672191586
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2657054680493771088}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Turkey
    Text: "\"\xC7avu\u015F deneyimli bir sava\u015F\xE7\u0131d\u0131r, zombilere
      kar\u015F\u0131 sava\u015Fta cephede durmakta, bu ac\u0131mas\u0131z k\u0131yamette
      zafer kazanmaya ve bar\u0131\u015F\u0131 sa\u011Flamaya \xE7al\u0131\u015Fmaktad\u0131r.\""
    Object: {fileID: 0}
  - Language: Russian
    Text: "\"\u0421\u0435\u0440\u0436\u0430\u043D\u0442 \u2013 \u043E\u043F\u044B\u0442\u043D\u044B\u0439
      \u0432\u043E\u0438\u043D, \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043E\u0432\u043E\u0439
      \u0432 \u0431\u0438\u0442\u0432\u0435 \u0441 \u0437\u043E\u043C\u0431\u0438,
      \u0441\u0442\u0440\u0435\u043C\u044F\u0441\u044C \u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043F\u043E\u0431\u0435\u0434\u0443 \u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u043C\u0438\u0440 \u0432 \u044D\u0442\u043E\u043C \u0431\u0435\u0437\u0436\u0430\u043B\u043E\u0441\u0442\u043D\u043E\u043C
      \u0430\u043F\u043E\u043A\u0430\u043B\u0438\u043F\u0441\u0438\u0441\u0435.\""
    Object: {fileID: 0}
  - Language: English
    Text: '"The sergeant is an experienced warrior, standing on the front line in
      the battle against zombies, striving to win and restore peace in this ruthless
      apocalypse."'
    Object: {fileID: 0}
