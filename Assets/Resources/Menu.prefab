  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Turkey
    Text: "\"Scout, g\xFC\xE7l\xFC bir otomatik t\xFCfe\u011Fi olan \xE7evik bir
      at\u0131c\u0131d\u0131r. Do\u011Fru ve h\u0131zl\u0131 \xE7ekimleri, insanl\u0131\u011F\u0131
      kaostan kurtar\u0131rken zombilere \xF6l\xFCmc\xFCl bir darbe indiriyor.\""
    Object: {fileID: 0}
  - Language: Russian
    Text: "\"\u0421\u043A\u0430\u0443\u0442 \u2013 \u043B\u043E\u0432\u043A\u0438\u0439
      \u0441\u0442\u0440\u0435\u043B\u043E\u043A \u0441 \u043C\u043E\u0449\u043D\u043E\u0439
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u043E\u0439. \u0415\u0433\u043E
      \u0442\u043E\u0447\u043D\u044B\u0435 \u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u0435
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u043D\u0430\u043D\u043E\u0441\u044F\u0442
      \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0443\u0434\u0430\u0440
      \u0437\u043E\u043C\u0431\u0438, \u0441\u043F\u0430\u0441\u0430\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u043E
      \u043E\u0442 \u0445\u0430\u043E\u0441\u0430.\""
    Object: {fileID: 0}
  - Language: English
    Text: '"Scout is a clever shooter with a powerful automatic rifle. His accurate
      and fast shots deal a deadly blow to zombies, saving humanity from chaos."'
    Object: {fileID: 0}
