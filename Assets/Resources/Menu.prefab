  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Turkey
    Text: "G\xF6revler tamamlanm\u0131\u015Ft\u0131r. Konumda kalabilir veya men\xFCden
      \xE7\u0131kabilirsiniz"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0417\u0430\u0434\u0430\u0447\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u044B.
      \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043B\u043E\u043A\u0430\u0446\u0438\u0438 \u0438\u043B\u0438
      \u0432\u044B\u0439\u0442\u0438 \u0432 \u043C\u0435\u043D\u044E"
    Object: {fileID: 0}
  - Language: English
    Text: Tasks are completed. You can stay at the location or exit to the menu
    Object: {fileID: 0}
