  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Turkey
    Text: "Pozisyondaki d\xF6v\xFC\u015F\xE7\xFCn\xFCn becerilerini art\u0131r\u0131rken
      pozisyonun seviyesini y\xFCkseltir"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u043F\u043E\u0437\u0438\u0446\u0438\u0438, \u043F\u043E\u043F\u0443\u0442\u043D\u043E
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430\u0432\u044B\u043A\u0438 \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E\u0441\u044F
      \u043D\u0430 \u043D\u0438\u0445 \u0431\u043E\u0439\u0446\u0430"
    Object: {fileID: 0}
  - Language: English
    Text: Increases the level of the position, while increasing the skills of the
      fighter on it
    Object: {fileID: 0}
