  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Turkey
    Text: "Elinizdeki g\xF6reve ba\u011Fl\u0131 olarak sava\u015F\xE7\u0131lar\u0131
      pozisyonlar aras\u0131nda ta\u015F\u0131yabilirsiniz"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0442\u044C
      \u0431\u043E\u0439\u0446\u043E\u0432 \u043C\u0435\u0436\u0434\u0443 \u043F\u043E\u0437\u0438\u0446\u0438\u044F\u043C\u0438
      \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
      \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445 \u0437\u0430\u0434\u0430\u0447"
    Object: {fileID: 0}
  - Language: English
    Text: You can move fighters between positions depending on the task at hand
    Object: {fileID: 0}
